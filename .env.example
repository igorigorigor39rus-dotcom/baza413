# Только альтернативный локальный Python-сервер, не основная Supabase-версия.
# Для Supabase задайте секреты через Dashboard, см. README.
# Скопируйте этот файл в .env. .env игнорируется Git.
# true — локальный браузер без Telegram, отдельная общая демонстрационная база.
# Для реального бота обязательно false!
DEMO_MODE=true

# Только для реального бота. Получите у @BotFather; не присылайте токен в чат.
TELEGRAM_BOT_TOKEN=

# Публичный HTTPS-адрес HTTP-сервера, например https://paws.example.com
APP_URL=

# Необязательно: каталог SQLite и фото. По умолчанию ./data рядом с README.
# DATA_DIR=
